# Copy to .env for local development. .env is git-ignored and must never
# be committed. Production values are supplied by the deployment platform's
# secret store, not by a file.

# --- Runtime ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database ---
# DB_NAME, DB_PORT and DB_USERNAME are also read by docker-compose.yml.
DB_NAME=taskmanagement
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/taskmanagement
DB_USERNAME=taskmanagement
DB_PASSWORD=taskmanagement
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- API documentation ---
OPENAPI_ENABLED=true

# --- Authentication ---
# Required in every environment except dev, which falls back to a known
# development key. At least 32 bytes: HS256 needs 256 bits and startup
# refuses anything shorter.
JWT_SECRET=change-me-to-at-least-thirty-two-bytes-of-random
JWT_ISSUER=task-management-platform
JWT_AUDIENCE=task-management-platform-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# False only for plain-HTTP local development.
REFRESH_COOKIE_SECURE=false
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m

# --- First platform administrator ---
# Creates one at startup when none exists. Set both or neither: half the pair
# fails startup rather than silently leaving the platform unadministered.
# Never commit real values.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# --- Mail ---
# No transport yet. Messages are written to the log, and in dev the link is
# written in full so verification and reset can be completed locally.
MAIL_LINK_BASE_URL=http://localhost:5173

# --- Attachment storage ---
# LOCAL writes uploaded files under STORAGE_LOCAL_DIR on this machine. It is
# fine for development and is refused at startup in production, where the
# requirements say attachments must live in object storage.
#
# No object-storage provider has been chosen yet, so STORAGE_PROVIDER=S3 also
# fails at startup, and says so. Choosing one is recorded as open in
# docs/architecture.md.
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./var/attachments
# Both limits are refused with 413: the container applies the first before
# reading a body, the application the second once it has the bytes.
ATTACHMENT_MAX_SIZE=10MB
ATTACHMENT_MAX_REQUEST_SIZE=12MB
# How long a presigned download URL lasts, once a provider that issues one exists.
ATTACHMENT_URL_TTL=5m

# Placeholders for later phases. Listed here so the full environment
# contract is visible in one place. Not read yet.
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
