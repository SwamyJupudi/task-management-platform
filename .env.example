# Copy to .env for local development. .env is git-ignored and must never
# be committed. Production values are supplied by the deployment platform's
# secret store, not by a file.

# --- Runtime ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database ---
# DB_NAME, DB_PORT and DB_USERNAME are also read by docker-compose.yml.
DB_NAME=taskmanagement
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/taskmanagement
DB_USERNAME=taskmanagement
DB_PASSWORD=taskmanagement
DB_POOL_MAX_SIZE=10
DB_CONNECTION_TIMEOUT_MS=30000

# --- Web ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Response compression. On everywhere. The mime-type allowlist lives in
# application.properties and deliberately excludes already-compressed types, so
# an attachment download is never run through gzip.
RESPONSE_COMPRESSION_ENABLED=true
RESPONSE_COMPRESSION_MIN_SIZE=1KB

# Container sizing. TOMCAT_MAX_THREADS is deliberately near DB_POOL_MAX_SIZE's
# order of magnitude rather than at Tomcat's default of 200: threads far in
# excess of the pool queue inside the application instead of applying
# backpressure at the front door. Raise this and DB_POOL_MAX_SIZE together.
TOMCAT_MAX_THREADS=100
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_MAX_CONNECTIONS=8192
TOMCAT_ACCEPT_COUNT=100
TOMCAT_CONNECTION_TIMEOUT=20s
TOMCAT_KEEP_ALIVE_TIMEOUT=20s
TOMCAT_MAX_KEEP_ALIVE_REQUESTS=100

# How long in-flight requests get to finish after SIGTERM before the process
# exits anyway. Read only under the prod profile, which is where graceful
# shutdown is switched on. Keep it BELOW the orchestrator's termination grace
# period, or the platform kills the process first and this does nothing.
SHUTDOWN_GRACE_PERIOD=30s

# --- API documentation ---
OPENAPI_ENABLED=true

# --- Authentication ---
# Required in every environment except dev, which falls back to a known
# development key. At least 32 bytes: HS256 needs 256 bits and startup
# refuses anything shorter.
JWT_SECRET=change-me-to-at-least-thirty-two-bytes-of-random
JWT_ISSUER=task-management-platform
JWT_AUDIENCE=task-management-platform-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# False only for plain-HTTP local development.
REFRESH_COOKIE_SECURE=false
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m

# --- First platform administrator ---
# Creates one at startup when none exists. Set both or neither: half the pair
# fails startup rather than silently leaving the platform unadministered.
# Never commit real values.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# --- Mail ---
# LOG writes messages to the log instead of delivering them, and in dev the link
# is written in full so verification and reset can be completed locally. It is
# REFUSED AT STARTUP under the prod profile: a deployment that delivers nothing
# cannot verify an address, reset a password or complete an invitation, and
# because verification is required to sign in, nobody could get in at all.
#
# SMTP is the production provider. Point it at a real server here if you want to
# exercise delivery locally -- Mailpit or MailHog on :1025 needs no credentials.
#
# HTTP is the third option: delivery by POST to a provider's API rather than over
# SMTP, for hosts that restrict outbound mail ports. It ignores every SMTP_* value
# below and reads MAIL_HTTP_API_KEY and MAIL_HTTP_URL instead; both it and SMTP
# need MAIL_FROM.
MAIL_PROVIDER=LOG
MAIL_LINK_BASE_URL=http://localhost:5173

# Required when MAIL_PROVIDER=SMTP or HTTP, and checked at startup. Most providers
# reject a message whose sender they do not recognise.
MAIL_FROM=
MAIL_FROM_NAME=

# The transport. Read by Spring Boot, so no host means no mail client is built at
# all; MAIL_PROVIDER=SMTP with SMTP_HOST empty fails startup with that message
# rather than with an unsatisfied dependency.
#
# SMTP_PASSWORD is a secret like any other. It is never committed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on the submission port, which is what 587 is for. A local Mailpit
# wants SMTP_AUTH=false and SMTP_STARTTLS=false.
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_TIMEOUT=10000

# The HTTP transport's own settings, read only when MAIL_PROVIDER=HTTP (or, under
# the demo profile, whenever the key is set). The default URL is Resend's, whose
# body shape the sender writes; a provider accepting the same shape needs only the
# URL changed. The key is a secret like any other and is never committed.
MAIL_HTTP_URL=https://api.resend.com/emails
MAIL_HTTP_API_KEY=

# --- Attachment storage ---
# LOCAL writes uploaded files under STORAGE_LOCAL_DIR on this machine. It is
# fine for development and is refused at startup in production, where the
# requirements say attachments must live in object storage.
#
# S3 is the production provider, and the prod profile defaults to it. It also
# covers anything that speaks the S3 API — MinIO, Cloudflare R2, DigitalOcean
# Spaces — through STORAGE_ENDPOINT and STORAGE_PATH_STYLE.
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=./var/attachments

# Required when STORAGE_PROVIDER=S3. The application refuses to start without
# them and names the one that is missing.
# STORAGE_BUCKET=
# STORAGE_REGION=
# An alternative endpoint. Leave unset for Amazon S3.
# STORAGE_ENDPOINT=http://localhost:9000
# Address the bucket as a path rather than a subdomain. Needed by every
# S3-compatible server except Amazon's own.
# STORAGE_PATH_STYLE=true
#
# CREDENTIALS ARE NOT SET HERE, and there is no property for them. The AWS SDK
# reads its default chain: a container role (IRSA, ECS task role), then an
# instance profile, then AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in the
# environment. A deployment should use a role, so that nothing long-lived is
# stored anywhere and rotation needs no redeploy.
# Both limits are refused with 413: the container applies the first before
# reading a body, the application the second once it has the bytes.
ATTACHMENT_MAX_SIZE=10MB
ATTACHMENT_MAX_REQUEST_SIZE=12MB
# How long a presigned download URL lasts. A security setting: the URL carries
# its own authorization, so this is how long a leaked one keeps working.
ATTACHMENT_URL_TTL=5m

# --- Malware scanning ------------------------------------------------------
# DISABLED reports every uploaded file clean WITHOUT INSPECTING IT. Fine for
# development; refused at startup in production, like LOCAL storage.
#
# HTTP posts the file to MALWARE_SCAN_URL and reads the verdict from the status
# code: 200 clean, 422 infected (first line of the body is the signature),
# anything else an error and the upload is refused with 503. Any engine can be
# put behind that contract with a small shim, which is why no product is named
# here. HttpMalwareScanner documents it in full.
#
# PRODUCTION FAILS CLOSED: the scanner is probed at startup and the application
# will not start without it. Bring the scanner up first, and note that a restart
# during a scanner outage leaves instances unable to come back until it returns.
MALWARE_SCAN_PROVIDER=DISABLED
# Required when MALWARE_SCAN_PROVIDER=HTTP. The prod profile defaults the
# provider to HTTP, so a production deployment must set this.
# MALWARE_SCAN_URL=http://clamav-gateway.internal:8080/scan
# Paid inside the upload request: how long a user waits on a slow scanner.
MALWARE_SCAN_TIMEOUT=10s

# Placeholders for later phases. Listed here so the full environment
# contract is visible in one place. Not read yet.
# MAIL_HOST=
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- Notifications ---------------------------------------------------------
# The deadline scan is the only scheduled job in the platform. Turning it off
# stops the daily "your deadline is approaching" messages and nothing else.
DEADLINE_SCAN_ENABLED=true
# Spring cron: second minute hour day month weekday. Daily at 07:00 by default.
DEADLINE_SCAN_CRON=0 0 7 * * *
# How many days ahead of a due date somebody is told.
DEADLINE_LEAD_DAYS=2

# --- Scheduled cleanup -----------------------------------------------------
# Two purges, BOTH OFF BY DEFAULT, unlike the deadline scan above. The scan
# sends a message; these delete data, so a deployment opts in rather than
# discovering they have been running. Switch them on in production: without
# them the token tables and the object store grow without bound.
#
# Expired tokens. Retention is counted from expiry, not from issue.
TOKEN_PURGE_ENABLED=false
TOKEN_PURGE_CRON=0 30 3 * * *
TOKEN_PURGE_RETENTION=30d
TOKEN_PURGE_BATCH_SIZE=500

# The bytes behind soft-deleted attachments. ATTACHMENT_PURGE_RETENTION is the
# window in which a file deleted by mistake can still be recovered: the row is
# soft-deleted and the object is intact until the purge takes it. Shortening
# this shortens that window, and there is no undo afterwards.
ATTACHMENT_PURGE_ENABLED=false
ATTACHMENT_PURGE_CRON=0 15 4 * * *
ATTACHMENT_PURGE_RETENTION=30d
ATTACHMENT_PURGE_BATCH_SIZE=200

# The unscanned backlog. V12 records every attachment that predates malware
# scanning as PENDING rather than marking it clean without looking, so upgrading
# a populated installation makes those files undownloadable (409) until they have
# been scanned. Their rows, metadata and listings are untouched.
#
# SWITCH THIS ON when upgrading such an installation: it is the only thing that
# promotes those files, and there is no shortcut that marks them clean. Expect it
# to read every unscanned file out of object storage, so budget the egress and the
# scanner load. It needs MALWARE_SCAN_PROVIDER=HTTP to do anything useful.
ATTACHMENT_RESCAN_ENABLED=false
ATTACHMENT_RESCAN_CRON=0 20 * * * *
ATTACHMENT_RESCAN_BATCH_SIZE=50

# Scheduler threads. Two, so a purge that runs long cannot postpone the
# deadline scan behind it on a single-threaded scheduler.
SCHEDULER_POOL_SIZE=2

# --- Redis and rate limiting -----------------------------------------------
# Redis holds the rate limiter's counters, and nothing else. It is NOT a cache:
# caching is not switched on anywhere in the application, which is how the
# standing decision that a resolved permission set must not be cached is kept.
#
# REDIS_PORT is also read by docker-compose.yml. The compose service is behind
# a profile, so start it with `docker compose --profile redis up -d`; with no
# Redis reachable the limiter fails open and everything still works, which is
# what local development gets by default.
REDIS_HOST=localhost
REDIS_PORT=6379
# Set on a managed instance. Left blank locally.
# REDIS_USERNAME=
# REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL=false
# SHORT ON PURPOSE. The limiter allows requests through when Redis cannot be
# reached, so an unreachable Redis costs this much latency per request until the
# backoff below takes over. A multi-second timeout would honour the fail-open
# and still make the application unusable.
REDIS_TIMEOUT=250ms
REDIS_CONNECT_TIMEOUT=250ms

# Rate limiting. On by default; off is for a deployment that limits at a
# gateway in front of the application instead.
RATE_LIMIT_ENABLED=true
# How long the limiter stops consulting Redis after a failure, so an outage
# costs one timeout rather than one per request.
RATE_LIMIT_UNAVAILABLE_BACKOFF=30s

# Per caller address.
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
RATE_LIMIT_REGISTRATIONS_PER_HOUR=5

# Per account, keyed by a hash of the address so no address reaches Redis.
# RATE_LIMIT_LOGIN_PER_ACCOUNT must stay ABOVE LOCKOUT_MAX_ATTEMPTS, or a 429
# would be returned before the account lockout is ever reached and somebody who
# mistyped their password would be told to come back later rather than that
# their account is locked.
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_REGISTRATIONS_PER_ACCOUNT=3
RATE_LIMIT_RECOVERY_PER_ACCOUNT=5

# --- Reports and dashboards ------------------------------------------------
# Nothing in this phase is cached, so every figure is computed at request time.
# These four are the bounds on what a single request may ask for.
# The window used when a request names neither end of one.
REPORT_DEFAULT_PERIOD_DAYS=30
# The widest window accepted. A year and a day, so "the last twelve months"
# inclusive of both ends is not refused by one.
REPORT_MAX_PERIOD_DAYS=366
# How far ahead the employee dashboard looks for deadlines. Deliberately larger
# than DEADLINE_LEAD_DAYS: a notification is a nudge, a dashboard is planning.
REPORT_UPCOMING_LEAD_DAYS=7
# The cap on a report listing. A larger page is refused rather than clamped, so
# a client's own paging arithmetic cannot quietly go wrong.
REPORT_MAX_PAGE_SIZE=100

# --- Admin panel -----------------------------------------------------------
# The admin panel is the only part of the platform that crosses workspaces, and
# its queries are the only ones with no workspace predicate to narrow them.
# These three are the bounds on what one request may ask for.
# The trailing window the "recent" statistics use when a request names none.
ADMIN_STATS_WINDOW_DAYS=30
# The widest window accepted. A year and a day, matching REPORT_MAX_PERIOD_DAYS,
# so the two administrative surfaces agree about what is too far back.
ADMIN_MAX_STATS_WINDOW_DAYS=366
# The cap on an admin listing. A larger page is refused rather than clamped.
ADMIN_MAX_PAGE_SIZE=100
