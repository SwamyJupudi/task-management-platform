{
  "Version": "2012-10-17",
  "Id": "task-management-platform-attachment-access",
  "Statement": [
    {
      "Sid": "TheThreeOperationsS3FileStorePerforms",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE-WITH-BUCKET-NAME/*"
    }
  ]
}
