# The production environment contract.
#
# THIS FILE CONTAINS NO VALUES AND MUST NEVER CONTAIN ANY. It is the list of
# what a deployment has to supply and the shape each one takes. The real file
# lives on the deployment host as `.env` beside docker-compose.prod.yml, is
# written by the deploy job from the CI secret store, and is 0600 and
# root-owned. It is not in this repository and never will be.
#
# .env.example is the development contract and documents why each setting exists
# at length. This file does not repeat that. It records the two things that are
# specific to production: which values are REQUIRED here and have no usable
# default, and which ones differ from what a developer runs.
#
# HOW A VALUE GETS HERE
#
# GitHub Actions secrets -> the deploy workflow -> /opt/task-management-platform/.env
#
# A single host with Docker Compose has no platform secret store, so a
# root-owned 0600 file is the floor rather than the ideal. A deployment with AWS
# Systems Manager or Secrets Manager available should fetch these at start-up
# instead; docs/deployment.md describes both and is honest about the difference.
#
# WHAT MUST NEVER APPEAR IN THIS FILE
#
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#       The SDK reads an instance or container role. A key pair here is a
#       long-lived secret rotated only by redeploying. See deploy/aws/README.md.
#   SPRING_PROFILES_ACTIVE / SERVER_PORT / MALWARE_SCAN_URL / REDIS_HOST
#       Fixed by docker-compose.prod.yml, because they are properties of the
#       topology rather than of the environment. Setting them here would let one
#       of them drift and break the stack in a way the compose file denies.
#   OPENAPI_ENABLED=true, or anything that switches a console on
#       The prod profile already serves no Swagger UI. Leave it that way.

# ===========================================================================
# Images. Set by the deploy job to the digest or tag it just pushed.
# ===========================================================================
BACKEND_IMAGE=ghcr.io/OWNER/REPO/backend:GIT_SHA
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/frontend:GIT_SHA
SCAN_GATEWAY_IMAGE=ghcr.io/OWNER/REPO/scan-gateway:GIT_SHA

# ===========================================================================
# The public identity of this deployment
# ===========================================================================
# The hostname the certificate is issued for and the only name the edge proxy
# answers to. Everything else on this list that mentions a URL must agree with
# it, because the refresh cookie is SameSite=Strict and one origin is what makes
# a session survive a reload.
APP_SERVER_NAME=app.example.com

# The bucket's own origin, which has to appear in the page's connect-src: an
# attachment download is a fetch that follows a 302 to a presigned URL. Get this
# wrong and downloads fail with a Content-Security-Policy violation.
APP_S3_ORIGIN=https://REPLACE-WITH-BUCKET.s3.REPLACE-WITH-REGION.amazonaws.com

# Same host, https. CORS is nearly vestigial in a single-origin deployment, but
# it must not be left pointing at a development port, and it must never be *.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Where a verification or password-reset link points. A mismatch here sends
# users to a host that does not serve this application.
MAIL_LINK_BASE_URL=https://app.example.com

# ===========================================================================
# Database. A managed instance, not a container.
# ===========================================================================
# sslmode=require at minimum. verify-full where the CA certificate is available
# to the container, which is stronger: `require` encrypts but authenticates
# nothing, so it does not defend against an interposed server.
DB_URL=jdbc:postgresql://db.internal:5432/taskmanagement?sslmode=require

# The RUNTIME role. It must be a member of task_platform_app, the NOLOGIN group
# V13 creates, and it must NOT own the schema: that is what withholds UPDATE and
# DELETE on activity_logs from the running application. docs/deployment.md has
# the CREATE ROLE and the GRANT.
DB_USERNAME=tmp_app
DB_PASSWORD=

# The MIGRATION role, which owns the schema. Bound straight from the
# environment by Spring Boot; there is no line for it in any properties file and
# application-prod.properties explains why. Omit both if this deployment runs
# with a single role, in which case Flyway uses the datasource above and the
# audit privileges are not separated.
SPRING_FLYWAY_USER=tmp_migrator
SPRING_FLYWAY_PASSWORD=

# Raise these two together or neither: threads far in excess of the pool queue
# inside the application instead of applying backpressure at the front door.
DB_POOL_MAX_SIZE=20
TOMCAT_MAX_THREADS=100

# ===========================================================================
# Authentication
# ===========================================================================
# At least 32 bytes; startup refuses anything shorter rather than signing with a
# key too weak for HS256. Generate with:  openssl rand -base64 48
#
# ROTATING THIS INVALIDATES EVERY ACCESS TOKEN IMMEDIATELY. Refresh tokens are
# database-backed and survive, so users are not signed out — the next refresh
# issues a token under the new key.
JWT_SECRET=

# True, and there is no reason for it ever to be false here. A Secure cookie is
# not stored by a browser over plain HTTP, so a deployment that set this false
# because "sign-in was not working" would have disabled the control instead of
# fixing the TLS.
REFRESH_COOKIE_SECURE=true

# ===========================================================================
# The first platform administrator
# ===========================================================================
# Read only when the platform has no administrator at all, which is the first
# boot of an empty database. Set both or neither: half the pair fails startup.
#
# Set a generated password, sign in, change it, and REMOVE THESE TWO LINES from
# the host's env file afterwards. Leaving them is a standing credential in a
# file that outlives its purpose.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ===========================================================================
# Attachment storage
# ===========================================================================
# S3 is also the prod profile's default, but it is stated here so that reading
# this file tells the whole story. LOCAL is refused at startup under prod.
STORAGE_PROVIDER=S3
STORAGE_BUCKET=
STORAGE_REGION=

# Leave both unset for Amazon. Set them for MinIO, R2 or Spaces.
# STORAGE_ENDPOINT=
# STORAGE_PATH_STYLE=true

# How long a presigned download URL lasts, and therefore how long a leaked one
# keeps working. Five minutes is the default and lengthening it is a security
# decision, not a performance one.
ATTACHMENT_URL_TTL=5m

# ===========================================================================
# Malware scanning
# ===========================================================================
# HTTP is the prod default and DISABLED is refused at startup. MALWARE_SCAN_URL
# is fixed by the compose file to the gateway on the backplane network.
#
# THE SCANNER IS A HARD STARTUP DEPENDENCY. The application probes it while its
# context refreshes and will not start if it does not answer, which means a
# restart during a scanner outage leaves instances unable to come back. That is
# what failing closed costs and there is deliberately no flag to relax it.
MALWARE_SCAN_PROVIDER=HTTP
MALWARE_SCAN_TIMEOUT=10s

# ===========================================================================
# Redis
# ===========================================================================
# Generate with:  openssl rand -base64 32
# Not optional. An unauthenticated Redis lets anyone who reaches it reset
# another caller's rate-limit counters, which is the whole defence in front of
# /auth/login and /auth/register.
REDIS_PASSWORD=

# False because Redis sits on the compose backplane network with no published
# port, so the traffic never leaves the host. Set it true, with a username and
# password, the moment Redis becomes a managed instance reached over a network.
REDIS_SSL=false

# ===========================================================================
# Scheduled jobs
#
# ALL THREE ARE OFF BY DEFAULT IN THE APPLICATION and are switched on here. That
# is the deliberate shape: a deployment opts into deletion rather than
# discovering it has been running.
# ===========================================================================
# Expired tokens. Without it user_tokens and refresh_tokens grow without bound.
TOKEN_PURGE_ENABLED=true

# The bytes behind soft-deleted attachments. Its retention is also the window in
# which a file deleted by mistake can still be recovered, and there is no undo
# after it. Keep it at or below the bucket's noncurrent-version expiry.
ATTACHMENT_PURGE_ENABLED=true
ATTACHMENT_PURGE_RETENTION=30d

# THE UNSCANNED BACKLOG. Leave this FALSE on a new installation: there is
# nothing to rescan and it would run hourly for no reason.
#
# Switch it to TRUE when upgrading an installation that already had attachments
# before phase ten. V12 recorded every one of them as PENDING rather than
# claiming they had been scanned, so they answer 409 on download until something
# has actually looked at them, and this job is the only thing that promotes
# them. Expect it to read every unscanned file out of the bucket: budget the
# egress and the scanner load, and switch it off again once the backlog is
# clear.
ATTACHMENT_RESCAN_ENABLED=false

# The deadline scan, which sends notifications rather than deleting anything,
# and is on by default in the application.
DEADLINE_SCAN_ENABLED=true

# ===========================================================================
# Shutdown
# ===========================================================================
# Must stay BELOW the stop_grace_period in docker-compose.prod.yml, which is
# 45s. Above it, Docker sends SIGKILL first and the graceful shutdown never
# runs.
SHUTDOWN_GRACE_PERIOD=30s
