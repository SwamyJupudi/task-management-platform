# Copy to .env.local for local development. Only .env.example is committed.
#
# Vite exposes VITE_-prefixed values to the browser bundle, so NOTHING secret
# belongs in this file or in any .env file here. There are no client secrets
# in this application: the access token is held in memory and the refresh
# token is an httpOnly cookie the browser manages.

# --- Backend ---------------------------------------------------------------
# The Spring API, including its base path. app.api.base-path is /api/v1 and
# local development listens on 8081, which application-dev.properties sets.
#
# Left as a relative path on purpose, so requests go through the dev proxy in
# vite.config.ts and the app is same-origin with the API.
#
# This is not a convenience. The refresh cookie is SameSite=Strict, so a
# browser will not attach it to a request from http://localhost:5173 to
# http://localhost:8081: they are different origins and therefore cross-site.
# Pointed straight at the backend, sign-in appears to work and then every
# reload signs the user back out, because /auth/refresh arrives with no cookie.
#
# Set this to an absolute URL only for a deployment that serves the interface
# and the API from the same site.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api. Only read by vite.config.ts, never
# bundled. 8081 because application-dev.properties puts the backend there;
# change it if yours listens somewhere else.
VITE_DEV_PROXY_TARGET=http://localhost:8081

# How long a request may run before the client gives up, in milliseconds.
VITE_API_TIMEOUT_MS=30000

# --- Interface -------------------------------------------------------------
VITE_APP_NAME=Task Management Platform

# Shows the TanStack Query devtools panel. Leave off unless debugging cache
# behaviour; the package is not installed yet, so this is inert for now.
VITE_ENABLE_QUERY_DEVTOOLS=false
